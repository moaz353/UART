###################################################################

# Created by write_sdc on Sat Aug 29 05:05:21 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current uA
set_operating_conditions -max ss0p95v125c -max_library saed32rvt_ss0p95v125c -min ff1p16vn40c -min_library saed32rvt_ff1p16vn40c
set_wire_load_model -name ForQA -library saed32rvt_tt1p05v25c
set_max_area 0
set_max_fanout 16 [current_design]
set_max_transition 0.5 [current_design]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports rst_n]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports {p_data[7]}]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports {p_data[6]}]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports {p_data[5]}]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports {p_data[4]}]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports {p_data[3]}]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports {p_data[2]}]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports {p_data[1]}]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports {p_data[0]}]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports data_valid]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports par_en]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports par_typ]
set_driving_cell -lib_cell IBUFFX2_RVT -library saed32rvt_tt1p05v25c -pin Y [get_ports rx_in]
set_load -pin_load 0.02 [get_ports tx_out]
set_load -pin_load 0.02 [get_ports busy]
set_load -pin_load 0.02 [get_ports {rx_p_data[10]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[9]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[8]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[7]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[6]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[5]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[4]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[3]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[2]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[1]}]
set_load -pin_load 0.02 [get_ports {rx_p_data[0]}]
set_load -pin_load 0.02 [get_ports rx_data_valid]
create_clock [get_ports clk]  -name sys_clk  -period 10  -waveform {0 5}
set_clock_latency 0  [get_clocks sys_clk]
set_clock_uncertainty -setup 0.2  [get_clocks sys_clk]
set_clock_uncertainty -hold 0.1  [get_clocks sys_clk]
set_clock_transition -max -rise 0.05 [get_clocks sys_clk]
set_clock_transition -min -rise 0.05 [get_clocks sys_clk]
set_clock_transition -max -fall 0.05 [get_clocks sys_clk]
set_clock_transition -min -fall 0.05 [get_clocks sys_clk]
group_path -name COMBO  -from [list [get_ports clk] [get_ports rst_n] [get_ports {p_data[7]}] [get_ports {p_data[6]}] [get_ports {p_data[5]}] [get_ports {p_data[4]}] [get_ports {p_data[3]}] [get_ports {p_data[2]}] [get_ports {p_data[1]}] [get_ports {p_data[0]}] [get_ports data_valid] [get_ports par_en] [get_ports par_typ] [get_ports rx_in]]  -to [list [get_ports tx_out] [get_ports busy] [get_ports {rx_p_data[10]}] [get_ports {rx_p_data[9]}] [get_ports {rx_p_data[8]}] [get_ports {rx_p_data[7]}] [get_ports {rx_p_data[6]}] [get_ports {rx_p_data[5]}] [get_ports {rx_p_data[4]}] [get_ports {rx_p_data[3]}] [get_ports {rx_p_data[2]}] [get_ports {rx_p_data[1]}] [get_ports {rx_p_data[0]}] [get_ports rx_data_valid]]
group_path -name INPUT  -from [list [get_ports clk] [get_ports rst_n] [get_ports {p_data[7]}] [get_ports {p_data[6]}] [get_ports {p_data[5]}] [get_ports {p_data[4]}] [get_ports {p_data[3]}] [get_ports {p_data[2]}] [get_ports {p_data[1]}] [get_ports {p_data[0]}] [get_ports data_valid] [get_ports par_en] [get_ports par_typ] [get_ports rx_in]]
group_path -name OUTPUT  -to [list [get_ports tx_out] [get_ports busy] [get_ports {rx_p_data[10]}] [get_ports {rx_p_data[9]}] [get_ports {rx_p_data[8]}] [get_ports {rx_p_data[7]}] [get_ports {rx_p_data[6]}] [get_ports {rx_p_data[5]}] [get_ports {rx_p_data[4]}] [get_ports {rx_p_data[3]}] [get_ports {rx_p_data[2]}] [get_ports {rx_p_data[1]}] [get_ports {rx_p_data[0]}] [get_ports rx_data_valid]]
set_input_delay -clock sys_clk  2  [get_ports rst_n]
set_input_delay -clock sys_clk  2  [get_ports {p_data[7]}]
set_input_delay -clock sys_clk  2  [get_ports {p_data[6]}]
set_input_delay -clock sys_clk  2  [get_ports {p_data[5]}]
set_input_delay -clock sys_clk  2  [get_ports {p_data[4]}]
set_input_delay -clock sys_clk  2  [get_ports {p_data[3]}]
set_input_delay -clock sys_clk  2  [get_ports {p_data[2]}]
set_input_delay -clock sys_clk  2  [get_ports {p_data[1]}]
set_input_delay -clock sys_clk  2  [get_ports {p_data[0]}]
set_input_delay -clock sys_clk  2  [get_ports data_valid]
set_input_delay -clock sys_clk  2  [get_ports par_en]
set_input_delay -clock sys_clk  2  [get_ports par_typ]
set_input_delay -clock sys_clk  2  [get_ports rx_in]
set_output_delay -clock sys_clk  2  [get_ports tx_out]
set_output_delay -clock sys_clk  2  [get_ports busy]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[10]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[9]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[8]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[7]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[6]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[5]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[4]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[3]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[2]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[1]}]
set_output_delay -clock sys_clk  2  [get_ports {rx_p_data[0]}]
set_output_delay -clock sys_clk  2  [get_ports rx_data_valid]
